{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NanoShadowrocket",
  "version": "1.2.0",
  "identifier": "com.nanoshadowrocket.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run prepare:sidecar && bun run dev",
    "beforeBuildCommand": "bun run prepare:sidecar && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NanoShadowrocket",
        "width": 900,
        "height": 620,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#0B0D10",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxOEI1NkRFRjMwNERDOTEKUldTUjNBVHozbGFMc1ZuWXNNWTluenlvaXMvaFFOZDRKQ1VadE5RVUZocG03U2hDRUx4byt4cEQK",
      "endpoints": [
        "https://github.com/Gort-Li/NanoShadowrocket/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/v2ray"],
    "resources": ["resources/v2ray-LICENSE.txt"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
